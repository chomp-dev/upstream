{
  "expo": {
    "name": "Chomp",
    "slug": "chomp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/chomp_logo.png",
    "scheme": "chomp",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/chomp_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0B0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.usechomp.chomp",
      "buildNumber": "18",
      "config": {
        "googleMapsApiKey": "AIzaSyAqq6mTFvn6DnnQkW9MUhjx59lcX5644n0"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Chomp needs camera access to record videos.",
        "NSMicrophoneUsageDescription": "Chomp needs microphone access to record audio.",
        "NSPhotoLibraryUsageDescription": "Chomp needs photo library access to upload media.",
        "NSLocationWhenInUseUsageDescription": "Chomp needs your location to find nearby restaurants.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/chomp_logo.png",
        "backgroundColor": "#0D0B0A"
      },
      "package": "com.chomp.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAqq6mTFvn6DnnQkW9MUhjx59lcX5644n0"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "react-native-auth0",
        {
          "domain": "dev-dm0k5l2f2j2qi2g3.us.auth0.com",
          "customScheme": "com.usechomp.chomp.auth0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/demo"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a56de28-7fc3-485a-9649-245db73f4742"
      },
      "auth0Domain": "dev-dm0k5l2f2j2qi2g3.us.auth0.com",
      "auth0ClientId": "cZ9xwl88jRBNdVwfLZuq0mHaJSkajX7W"
    },
    "owner": "chomps-organization"
  }
}